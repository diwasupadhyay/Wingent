{
    "$schema":  "../node_modules/@tauri-apps/cli/config.schema.json",
    "productName":  "Wingent",
    "version":  "0.1.0",
    "identifier":  "com.wingent.app",
    "build":  {
                  "frontendDist":  "../dist",
                  "devUrl":  "http://127.0.0.1:5173",
                  "beforeDevCommand":  "npm run dev -- --host 127.0.0.1 --port 5173",
                  "beforeBuildCommand":  "npm run build"
              },
    "app":  {
                "windows":  [
                                {
                                    "label":  "main",
                                    "title":  "Wingent",
                                    "width":  760,
                                    "height":  92,
                                    "center":  true,
                                    "resizable":  false,
                                    "fullscreen":  false,
                                    "decorations":  false,
                                    "transparent":  true,
                                    "backgroundColor": "#00000000",
                                    "alwaysOnTop":  true,
                                    "skipTaskbar":  true,
                                    "shadow":  false,
                                    "visible":  false
                                }
                            ],
                "security":  {
                                 "csp":  null
                             }
            },
    "bundle":  {
                   "active":  true,
                   "targets":  "all",
                   "icon":  [
                                "icons/32x32.png",
                                "icons/128x128.png",
                                "icons/128x128@2x.png",
                                "icons/icon.icns",
                                "icons/icon.ico"
                            ],
                   "externalBin":  [
                                       "binaries/wingent-backend"
                                   ]
               }
}
